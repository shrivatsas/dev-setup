#!/usr/bin/env bash
# pi-attribution — print the GitHub attribution subtext line for pi sessions.
# Run immediately before posting and paste the output verbatim.
# Sums per-message usage blocks in $PI_SESSION_FILE; falls back to
# `tokens: unknown` only when the session file is missing or unreadable.
set -u

model="${PI_MODEL:-unknown}"
effort="${PI_REASONING_LEVEL:-unknown}"
session="${PI_SESSION_ID:-unknown}"
sfile="${PI_SESSION_FILE:-}"

tokens="unknown"
if [ -n "$sfile" ] && [ -r "$sfile" ]; then
  totals=$(python3 - "$sfile" <<'EOF' 2>/dev/null
import json, sys
inp = out = 0
try:
    with open(sys.argv[1]) as f:
        for line in f:
            try:
                o = json.loads(line)
            except Exception:
                continue
            if not isinstance(o, dict):
                continue
            m = o.get("message")
            u = None
            if isinstance(m, dict) and isinstance(m.get("usage"), dict):
                u = m["usage"]
            elif o.get("type") == "usage" and isinstance(o.get("usage"), dict):
                u = o["usage"]
            if u:
                try:
                    inp += int(u.get("input", 0))
                    out += int(u.get("output", 0))
                except (TypeError, ValueError):
                    pass
    print(f"{inp}/{out}")
except Exception:
    print("unknown")
EOF
)
  case "$totals" in
    [0-9]*/*) tokens="$totals" ;;
  esac
fi

esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

printf '<sub>harness: pi \u00b7 model: %s (%s) \u00b7 session: %s \u00b7 tokens: %s</sub>\n' \
  "$(esc "$model")" "$(esc "$effort")" "$(esc "$session")" "$tokens"
